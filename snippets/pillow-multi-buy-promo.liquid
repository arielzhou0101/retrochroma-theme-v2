{% liquid
  assign is_eligible = false
  assign promotion_badge_text = 'SPECIAL OFFER'
  assign promotion_text = 'Get 15% off your second silk pillowcase automatically.'

  if settings.pillow_multi_buy_promo_enabled
    if context == 'pdp' and product.handle == 'leopard-print-22-momme-silk-front-pillowcase'
      assign is_eligible = true
    endif
  endif
%}

{% if is_eligible %}
  <div class="pillow-multi-buy-promo pillow-multi-buy-promo--{{ context }}" role="note">
    <span class="pillow-multi-buy-promo__badge">
      <span class="pillow-multi-buy-promo__badge-icon" aria-hidden="true">
        {{ 'icon-discount.svg' | inline_asset_content }}
      </span>
      {{ promotion_badge_text | escape }}
    </span>
    <span class="pillow-multi-buy-promo__copy">
      <span class="pillow-multi-buy-promo__line">{{ promotion_text | escape }}</span>
    </span>
  </div>
{% endif %}
