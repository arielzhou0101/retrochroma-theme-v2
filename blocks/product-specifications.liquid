{% liquid
  assign specifications_product = closest.product
  if specifications_product == blank
    assign specifications_product = product
  endif
  if specifications_product == blank and section.settings.product != blank
    assign specifications_product = section.settings.product
  endif

  assign product_details = specifications_product.metafields.custom.product_details.value
  assign specifications = product_details.specifications
  assign notes = product_details.notes
  assign measurement_image = specifications_product.metafields.custom.measurement_image.value
  assign measurement_image_alt = measurement_image.alt | default: specifications_product.title
%}

{% stylesheet %}
  .product-specifications {
    width: 100%;
  }

  .product-specifications__heading {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 16px;
    color: color-mix(in srgb, var(--color-foreground) 76%, #9a6f36);
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .product-specifications__heading::after {
    width: 100%;
    height: 1px;
    content: '';
    background: color-mix(in srgb, var(--color-foreground) 18%, transparent);
  }

  .product-specifications__image {
    display: block;
    width: 68%;
    max-width: 420px;
    height: auto;
    margin: 0 auto 18px;
    opacity: 0.9;
    background: color-mix(in srgb, var(--color-foreground) 4%, transparent);
  }

  .product-specifications__table {
    margin: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
  }

  .product-specifications__notes {
    display: grid;
    gap: 12px;
    margin-top: 0;
  }

  .product-specifications__note {
    margin: 0;
  }

  .product-specifications__note-heading {
    margin: 0 0 4px;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .product-specifications__note-text {
    margin: 0;
    color: color-mix(in srgb, var(--color-foreground) 76%, transparent);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .product-specifications__row {
    display: grid;
    grid-template-columns: minmax(92px, 0.72fr) minmax(0, 1.28fr);
    gap: 16px;
    padding-block: 12px;
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
  }

  .product-specifications__label,
  .product-specifications__value {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .product-specifications__label {
    color: color-mix(in srgb, var(--color-foreground) 64%, transparent);
  }

  .product-specifications__value {
    color: var(--color-foreground);
    font-weight: 500;
    text-align: right;
  }

  .product-specifications__reference-link {
    display: inline-flex;
    justify-self: end;
    align-items: center;
    gap: 6px;
    color: var(--color-foreground);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.45;
    text-align: right;
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color var(--animation-speed) var(--animation-easing);
  }

  .product-specifications__reference-link:hover {
    color: var(--color-primary-hover);
  }

  .product-specifications__reference-row {
    border-bottom: 0;
  }

  .product-specifications__reference-arrow {
    font-size: 1rem;
    line-height: 1;
  }

  @media screen and (width < 750px) {
    .product-specifications__image {
      width: 82%;
    }

    .product-specifications__row {
      grid-template-columns: minmax(82px, 0.7fr) minmax(0, 1.3fr);
      gap: 12px;
    }
  }
{% endstylesheet %}

{% if specifications_product != blank and product_details != blank %}
  <section
    class="product-specifications spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    {% if block.settings.heading != blank %}
      <h2 class="product-specifications__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}

    {% if measurement_image != blank %}
      {{
        measurement_image
        | image_url: width: 1200
        | image_tag:
          class: 'product-specifications__image',
          loading: 'lazy',
          widths: '360, 540, 720, 900, 1200',
          alt: measurement_image_alt
      }}
    {% endif %}

    {% if specifications != blank %}
      <dl class="product-specifications__table">
        {% for specification in specifications %}
          {% if specification.label != blank and specification.value != blank %}
            <div class="product-specifications__row">
              <dt class="product-specifications__label">{{ specification.label | escape }}</dt>
              <dd class="product-specifications__value">{{ specification.value | escape | newline_to_br }}</dd>
            </div>
          {% endif %}
        {% endfor %}
      </dl>
    {% endif %}

    {% if notes != blank %}
      <div class="product-specifications__notes">
        {% for note in notes %}
          {% liquid
            assign note_text = note['text']
            assign note_link_url = note['link_url']
            assign note_link_label = note['link_label']
          %}
          {% if note_text != blank or note_link_url != blank %}
            {% if note_text == blank and note_link_url != blank and note_link_label != blank %}
              <div class="product-specifications__row product-specifications__reference-row">
                <span class="product-specifications__label">{{ note.heading | escape }}</span>
                <a class="product-specifications__reference-link" href="{{ note_link_url | escape }}" target="_blank" rel="noopener">
                  <span>{{ note_link_label | escape }}</span>
                  <span class="product-specifications__reference-arrow" aria-hidden="true">↗</span>
                </a>
              </div>
            {% else %}
              <div class="product-specifications__note">
                {% if note.heading != blank %}
                  <h3 class="product-specifications__note-heading">{{ note.heading | escape }}</h3>
                {% endif %}
                {% if note_text != blank %}
                  <p class="product-specifications__note-text">{{ note_text | escape | newline_to_br }}</p>
                {% endif %}
                {% if note_link_url != blank and note_link_label != blank %}
                  <a class="product-specifications__reference-link" href="{{ note_link_url | escape }}" target="_blank" rel="noopener">
                    <span>{{ note_link_label | escape }}</span>
                    <span class="product-specifications__reference-arrow" aria-hidden="true">↗</span>
                  </a>
                {% endif %}
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </section>
{% endif %}

{% schema %}
{
  "name": "Product details",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product Details"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
